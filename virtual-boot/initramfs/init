#!/bin/busybox sh
# Alpine handoff initramfs - Samsung SM-A205W / Exynos 7885
# Standalone source. It is not wired to a build workflow.

export PATH=/bin:/sbin:/usr/bin:/usr/sbin
export HOME=/root

LOG=""
EARLY_LOG="/tmp/diag.txt"
say() {
    echo "$*"
    if [ -n "$EARLY_LOG" ]; then
        echo "$*" >> "$EARLY_LOG" 2>/dev/null || true
    fi
    if [ -n "$LOG" ]; then
        echo "$*" >> "$LOG" 2>/dev/null || true
    fi
}

rescue_shell() {
    reason="$1"
    say ""
    say "[RESCUE] $reason"
    say "[RESCUE] Diagnostics follow."
    say "=== kernel command line ==="
    cat /proc/cmdline 2>/dev/null
    say "=== mounts ==="
    cat /proc/mounts 2>/dev/null
    say "=== block devices ==="
    ls -l /dev/mmc* /dev/block 2>/dev/null
    say "=== memory ==="
    head -20 /proc/meminfo 2>/dev/null
    say "=== recent kernel log ==="
    dmesg 2>/dev/null | tail -80
    say "[RESCUE] Interactive shell (exit will return to this rescue loop)."
    while :; do
        /bin/sh
        say "[RESCUE] Shell exited; reopening in 2 seconds."
        sleep 2
    done
}

# Prepare a usable console before any essential mount can fail.
mkdir -p /dev /proc /sys /run /tmp /mnt/data /newroot
if ! mount -t devtmpfs devtmpfs /dev 2>/dev/null; then
    # The current A20 kernel may not have CONFIG_DEVTMPFS.
    # Keep /dev writable so required nodes can be created manually.
    mount -t tmpfs -o mode=0755 tmpfs /dev 2>/dev/null || true
fi
if [ ! -c /dev/console ]; then
    mknod -m 600 /dev/console c 5 1 2>/dev/null || true
fi
if [ ! -c /dev/kmsg ]; then
    mknod -m 600 /dev/kmsg c 1 11 2>/dev/null || true
fi

if [ -c /dev/console ]; then
    exec </dev/console >/dev/console 2>&1
else
    echo "[FATAL] /dev/console is unavailable" >/dev/kmsg 2>/dev/null
    # Do not return to the bootloader or silently exit.
    while :; do sleep 3600; done
fi

mount -t proc proc /proc || rescue_shell "cannot mount /proc"
mount -t sysfs sysfs /sys || rescue_shell "cannot mount /sys"
mount -t tmpfs tmpfs /run || rescue_shell "cannot mount /run"
mount -t tmpfs tmpfs /tmp || rescue_shell "cannot mount /tmp"

# Start the trace only after /tmp is writable. It is copied to userdata
# as soon as the Android data partition becomes available.
: > "$EARLY_LOG" 2>/dev/null || true
say "[DIAG] initramfs entry reached"
say "[DIAG] Linux /init is executing"
say "=============================================="
say " Virtual Boot - Samsung SM-A205W / Exynos 7885"
say " Alpine Linux handoff"
say "=============================================="
say "[INFO] initramfs init started."
say "[INFO] Kernel command line:"
cat /proc/cmdline 2>/dev/null

DATA_DEV=""
attempt=0
mkdir -p /dev/block
while [ "$attempt" -lt 15 ] && [ -z "$DATA_DEV" ]; do
    # Without devtmpfs, create the userdata node from the kernel's sysfs
    # major:minor value. This avoids hard-coding a device number.
    if [ ! -b /dev/mmcblk0p33 ] && [ -r /sys/class/block/mmcblk0p33/dev ]; then
        DEVNUM="$(cat /sys/class/block/mmcblk0p33/dev 2>/dev/null)"
        case "$DEVNUM" in
            *:*)
                DEV_MAJOR="${DEVNUM%%:*}"
                DEV_MINOR="${DEVNUM##*:}"
                case "$DEV_MAJOR$DEV_MINOR" in
                    ""|*[!0-9]*) ;;
                    *)
                        mknod -m 600 /dev/mmcblk0p33 b "$DEV_MAJOR" "$DEV_MINOR" 2>/dev/null || true
                        ;;
                esac
                ;;
        esac
    fi

    if [ -b /dev/mmcblk0p33 ]; then
        DATA_DEV="/dev/mmcblk0p33"
    elif [ -b /dev/block/mmcblk0p33 ]; then
        DATA_DEV="/dev/block/mmcblk0p33"
    else
        sleep 1
    fi
    attempt=$((attempt + 1))
done

[ -n "$DATA_DEV" ] || rescue_shell "userdata block device mmcblk0p33 not found"

say "[INFO] Mounting userdata from $DATA_DEV..."
mount -t ext4 -o rw,noatime "$DATA_DEV" /mnt/data ||
    rescue_shell "failed to mount userdata as ext4"
say "[OK] Userdata mounted at /mnt/data."

DIAG_DIR="/mnt/data/media/0/UEFI"
mkdir -p "$DIAG_DIR" 2>/dev/null || true
LOG="$DIAG_DIR/diag.txt"
DIAG_DATE="$(date '+%Y-%m-%d %H:%M:%S %z' 2>/dev/null)"
[ -n "$DIAG_DATE" ] || DIAG_DATE="unknown"
{
    echo "A205W LINUX BOOT DIAGNOSTICS"
    echo "Date: $DIAG_DATE"
    echo "Entry: Linux selected in EDK2; initramfs reached"
    echo "----------------------------------------------"
    cat "$EARLY_LOG" 2>/dev/null
} > "$LOG" 2>/dev/null || LOG=""
if [ -n "$LOG" ]; then
    say "[DIAG] Persistent diagnostic file: $LOG"
    say "[DIAG] Kernel command line: $(cat /proc/cmdline 2>/dev/null)"
fi

ALPINE_ROOT="/mnt/data/media/0/UEFI/ALP/rootfs"
LOG="/mnt/data/media/0/UEFI/ALP/virtual-boot-init.log"
: > "$LOG" 2>/dev/null || true
say "[INFO] Diagnostic log: $LOG"
say "[CHECK] Alpine rootfs location:"
say "[PATH] $ALPINE_ROOT"
dmesg >> "$LOG" 2>/dev/null

say "[CHECK] Looking for rootfs directory..."
if [ -d "$ALPINE_ROOT" ]; then
    say "[OK] Rootfs directory exists."
    ls -ld "$ALPINE_ROOT" 2>/dev/null
else
    say "[FAIL] Rootfs directory not found."
    say "[FAIL] Expected directory: $ALPINE_ROOT"
    say "[INFO] Parent directory listing:"
    ls -la /mnt/data/media/0/UEFI/ALP 2>/dev/null
    rescue_shell "Alpine rootfs directory missing"
fi

say "[CHECK] Required Alpine init files:"
if [ -x "$ALPINE_ROOT/sbin/init" ]; then
    say "[OK] $ALPINE_ROOT/sbin/init"
else
    say "[FAIL] Missing or non-executable: $ALPINE_ROOT/sbin/init"
fi
if [ -x "$ALPINE_ROOT/bin/busybox" ]; then
    say "[OK] $ALPINE_ROOT/bin/busybox"
else
    say "[FAIL] Missing or non-executable: $ALPINE_ROOT/bin/busybox"
fi

if [ ! -x "$ALPINE_ROOT/sbin/init" ] || [ ! -x "$ALPINE_ROOT/bin/busybox" ]; then
    rescue_shell "Alpine rootfs incomplete (see checks above)"
fi

say "----------------------------------------------"
say "[OK] ROOTFS FOUND"
say "[PATH] $ALPINE_ROOT"
say "[OK] sbin/init is executable"
say "[OK] bin/busybox is executable"
say "----------------------------------------------"

mkdir -p "$ALPINE_ROOT/dev" "$ALPINE_ROOT/proc" "$ALPINE_ROOT/sys" "$ALPINE_ROOT/run"

mount --bind "$ALPINE_ROOT" /newroot ||
    rescue_shell "cannot bind-mount Alpine rootfs"

mount -o move /dev /newroot/dev || rescue_shell "cannot move /dev"
mount -o move /proc /newroot/proc || rescue_shell "cannot move /proc"
mount -o move /sys /newroot/sys || rescue_shell "cannot move /sys"
mount -o move /run /newroot/run || rescue_shell "cannot move /run"

say "[OK] Transferring execution to Alpine /sbin/init..."
exec switch_root /newroot /sbin/init

rescue_shell "switch_root failed or returned unexpectedly"
